#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ACTION="panel"
MODE="${1:-remaining}"

if [[ "$MODE" == "popup" ]]; then
  ACTION="popup"
  MODE="${2:-remaining}"
fi

for arg in "$@"; do
  if [[ "$arg" == "--no-icon" ]]; then
    export CODEXBAR_XFCE_SHOW_ICON=0
  fi
done

export CODEXBAR_XFCE_WRAPPER="$SCRIPT_DIR/codexbar-xfce-genmon"

exec python3 "$SCRIPT_DIR/codexbar_xfce_genmon.py" "$MODE" "$ACTION"
