#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Strip flags before positional parsing so flags can appear in any position.
POSITIONAL=()
ACTION="panel"
MODELS=()

for arg in "$@"; do
  case "$arg" in
    --no-icon)
      export CODEXBAR_XFCE_SHOW_ICON=0
      ;;
    --popup)
      ACTION="popup"
      ;;
    --model=codex|--model=claude|--model=copilot)
      MODELS+=("${arg#--model=}")
      ;;
    # Backwards-compatible aliases
    --source=codex|--codex-only)
      MODELS+=("codex")
      ;;
    --source=claude|--claude-only)
      MODELS+=("claude")
      ;;
    --source=both)
      MODELS+=("codex" "claude")
      ;;
    --copilot-only)
      MODELS+=("copilot")
      ;;
    *)
      POSITIONAL+=("$arg")
      ;;
  esac
done

# Export active models as comma-separated string; empty = all configured sources
if [[ ${#MODELS[@]} -gt 0 ]]; then
  export CODEXBAR_XFCE_MODELS="$(IFS=,; echo "${MODELS[*]}")"
fi

MODE="${POSITIONAL[0]:-rotate}"

if [[ "$MODE" == "popup" ]]; then
  ACTION="popup"
  MODE="${POSITIONAL[1]:-rotate}"
fi

export CODEXBAR_XFCE_WRAPPER="$SCRIPT_DIR/codexbar-xfce-genmon"

exec python3 "$SCRIPT_DIR/codexbar_xfce_genmon.py" "$MODE" "$ACTION"
