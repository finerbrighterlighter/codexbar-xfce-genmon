#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Strip flags before positional parsing so flags can appear in any position.
POSITIONAL=()
ACTION="panel"
for arg in "$@"; do
  case "$arg" in
    --no-icon)
      export CODEXBAR_XFCE_SHOW_ICON=0
      ;;
    --popup)
      ACTION="popup"
      ;;
    --source=codex|--source=claude|--source=both)
      export CODEXBAR_XFCE_SOURCE="${arg#--source=}"
      ;;
    --codex-only)
      export CODEXBAR_XFCE_SOURCE=codex
      ;;
    --claude-only)
      export CODEXBAR_XFCE_SOURCE=claude
      ;;
    *)
      POSITIONAL+=("$arg")
      ;;
  esac
done

MODE="${POSITIONAL[0]:-rotate}"

if [[ "$MODE" == "popup" ]]; then
  ACTION="popup"
  MODE="${POSITIONAL[1]:-rotate}"
fi

export CODEXBAR_XFCE_WRAPPER="$SCRIPT_DIR/codexbar-xfce-genmon"

exec python3 "$SCRIPT_DIR/codexbar_xfce_genmon.py" "$MODE" "$ACTION"
