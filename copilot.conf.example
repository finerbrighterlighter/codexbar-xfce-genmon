# GitHub personal access token
# Create a fine-grained token at: https://github.com/settings/personal-access-tokens
# Required permission: User permissions → Plan → Read-only
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback only: the real quota is read from Copilot automatically.
# Used if that fails (github.com/settings/billing shows "x / N AI credits"). Default: 1500
COPILOT_QUOTA=1500
