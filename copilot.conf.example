# GitHub personal access token
# Create a fine-grained token at: https://github.com/settings/personal-access-tokens
# Required permission: User permissions → Plan → Read-only
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your monthly included AI credits (github.com/settings/billing shows "x / N AI credits").
# Default: 1500
COPILOT_QUOTA=1500
